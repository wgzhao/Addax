# Connection parameters for the E2E databases.
#
# Single source of truth: sourced by run.sh (and by case verify scripts, which inherit
# the exported values), and by start-db.sh / stop-db.sh to configure the containers.
# Every value can be overridden from the environment.
#
# Keep every value free of spaces and shell metacharacters. run.sh forwards these to
# addax.sh as -D System properties inside a single -p argument, and addax.sh expands
# that argument through `sh -c` without quoting -- an `&` or a space here would tear
# the command line apart. run.sh validates this before every run (assert_param_safe).

# Host ports are deliberately NOT the database defaults: a developer machine very
# often already has a real MySQL or PostgreSQL listening on 3306/5432, and the
# suite must not care. The odd port also makes it obvious in a log which instance
# was involved.
MYSQL_HOST="${MYSQL_HOST:-127.0.0.1}"
MYSQL_PORT="${MYSQL_PORT:-13306}"
MYSQL_USER="${MYSQL_USER:-root}"
MYSQL_PASSWORD="${MYSQL_PASSWORD:-addax_pw}"
MYSQL_DB="${MYSQL_DB:-addax_e2e}"

POSTGRES_HOST="${POSTGRES_HOST:-127.0.0.1}"
POSTGRES_PORT="${POSTGRES_PORT:-15432}"
POSTGRES_USER="${POSTGRES_USER:-addax}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-addax_pw}"
POSTGRES_DB="${POSTGRES_DB:-addax_e2e}"

# The JDBC URLs are NOT built here. They are derived from the values above by
# db_jdbc_url() at the moment a job runs, because the container runtime can change
# the host after this file is sourced (see rt_apply_endpoints in lib/runtime.sh).
# Setting MYSQL_JDBC_URL / POSTGRES_JDBC_URL in the environment still wins, which is
# the way to run the suite against a database you manage yourself.

# Container names -- db key (mysql / postgres) -> container.
MYSQL_CONTAINER="${MYSQL_CONTAINER:-addax-e2e-mysql}"
POSTGRES_CONTAINER="${POSTGRES_CONTAINER:-addax-e2e-postgres}"

# Pinned deliberately: a floating tag can change behaviour under a green CI run.
# Bump these when you intend to move the floor, not by accident.
MYSQL_IMAGE="${MYSQL_IMAGE:-mysql:8.0}"
POSTGRES_IMAGE="${POSTGRES_IMAGE:-postgres:16}"
