DBS=""
SRC_DB=""
DST_DB=""
# The text rendering of DATE/TIME columns goes through ColumnCast.DateCast, whose zone
# defaults to GMT+8 regardless of the JVM zone (the same is true for every RDBMS reader;
# a MySQL TIME renders shifted too under TZ=UTC). Aligning the case with that default
# keeps the golden showing the wall clock the database actually stores.
CASE_TZ=Asia/Shanghai
