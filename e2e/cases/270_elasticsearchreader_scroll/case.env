DBS=""
SRC_DB=""
DST_DB=""

# The JVM inherits a proxy from the machine it runs on (on macOS via the system proxy
# settings), and the elasticsearch client is an HTTP client, so a proxy in the way makes
# the job fail with "502 Bad Gateway" or an UnknownHostException that has nothing to do
# with the plugin. The connection of this case is direct, so the proxy is disabled.
CASE_JVM_ARGS="-DsocksProxyHost= -Dhttp.proxyHost= -Dhttps.proxyHost="
