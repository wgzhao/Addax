{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      },
      "errorLimit": {
        "record": 0
      }
    },
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "username": "${mysql_user}",
            "password": "${mysql_password}",
            "column": [
              "id",
              "name",
              "qty",
              "price",
              "active",
              "note",
              "d",
              "t",
              "dt",
              "ts"
            ],
            "connection": {
              "table": [
                "e2e_src"
              ],
              "jdbcUrl": [
                "${mysql_jdbc_url}"
              ]
            }
          }
        },
        "writer": {
          "name": "postgresqlwriter",
          "parameter": {
            "username": "${postgres_user}",
            "password": "${postgres_password}",
            "writeMode": "insert",
            "column": [
              "id",
              "name",
              "qty",
              "price",
              "active",
              "note",
              "d",
              "t",
              "dt",
              "ts"
            ],
            "preSql": [
              "delete from @table"
            ],
            "connection": {
              "table": [
                "e2e_dst"
              ],
              "jdbcUrl": "${postgres_jdbc_url}"
            }
          }
        }
      }
    ]
  }
}