{
  "job": {
    "setting": {
      "speed": { "channel": 1 },
      "errorLimit": { "record": 0 }
    },
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "username": "${mysql_user}",
            "password": "${mysql_password}",
            "column": ["id", "name", "qty", "price", "active", "note"],
            "connection": {
              "table": ["e2e_src"],
              "jdbcUrl": ["${mysql_jdbc_url}"]
            }
          }
        },
        "writer": {
          "name": "duckdbwriter",
          "parameter": {
            "writeMode": "insert",
            "column": ["id", "name", "qty", "price", "active", "note"],
            "connection": {
              "table": ["e2e_dst"],
              "jdbcUrl": "jdbc:duckdb:${e2e_out_dir}/e2e.duckdb"
            }
          }
        }
      }
    ]
  }
}
