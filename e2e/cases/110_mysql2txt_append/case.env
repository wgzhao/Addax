DBS="mysql"
SRC_DB=mysql
DST_DB=""

# Known defect: writeMode=append cannot work. TxtFileWriter.prepare() deliberately
# keeps existing files matching fileName, then Task.startWrite() does
#   if (!newFile.createNewFile()) throw new IOException(...)
# which returns false exactly when the file exists -- so the job always fails on the
# file append is supposed to append to. Opening the stream would not help either:
# Files.newOutputStream() truncates by default. Marked rather than deleted so the
# defect stays asserted, and so this case flips to XPASS (a failure) once fixed.
EXPECTED_FAIL="txtfilewriter writeMode=append fails on a pre-existing file"
