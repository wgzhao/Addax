{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      },
      "errorLimit": {
        "record": 0
      }
    },
    "content": [
      {
        "reader": {
          "name": "postgresqlreader",
          "parameter": {
            "username": "${postgres_user}",
            "password": "${postgres_password}",
            "column": ["id", "name", "qty", "price", "active", "note"],
            "connection": {
              "table": ["e2e_src"],
              "jdbcUrl": ["${postgres_jdbc_url}"]
            }
          }
        },
        "writer": {
          "name": "postgresqlwriter",
          "parameter": {
            "username": "${postgres_user}",
            "password": "${postgres_password}",
            "writeMode": "update(id)",
            "column": ["id", "name", "qty", "price", "active", "note"],
            "postSql": ["insert into e2e_audit (phase, note) values ('post', '@table')"],
            "connection": {
              "table": ["e2e_upsert"],
              "jdbcUrl": "${postgres_jdbc_url}"
            }
          }
        }
      }
    ]
  }
}
