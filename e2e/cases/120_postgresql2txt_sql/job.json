{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      },
      "errorLimit": {
        "record": 0
      }
    },
    "content": [
      {
        "reader": {
          "name": "postgresqlreader",
          "parameter": {
            "username": "${postgres_user}",
            "password": "${postgres_password}",
            "column": ["id", "name", "qty", "price", "active", "note"],
            "connection": {
              "table": ["e2e_src"],
              "jdbcUrl": ["${postgres_jdbc_url}"]
            }
          }
        },
        "writer": {
          "name": "txtfilewriter",
          "parameter": {
            "path": "${e2e_out_dir}",
            "fileName": "load.sql",
            "fileFormat": "sql",
            "writeMode": "truncate",
            "table": "e2e_dst",
            "column": ["id", "name", "qty", "price", "active", "note"],
            "batchSize": 30
          }
        }
      }
    ]
  }
}
