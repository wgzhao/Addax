{
  "job": {
    "setting": {
      "speed": { "channel": 1 },
      "errorLimit": { "record": 0 }
    },
    "content": [
      {
        "reader": {
          "name": "txtfilereader",
          "parameter": {
            "path": ["${e2e_out_dir}/in.csv"],
            "column": [
              {"index": 0, "type": "long"},
              {"index": 1, "type": "string"},
              {"index": 2, "type": "long"},
              {"index": 3, "type": "double"},
              {"index": 4, "type": "boolean"}
            ],
            "fieldDelimiter": ","
          }
        },
        "writer": {
          "name": "duckdbwriter",
          "parameter": {
            "writeMode": "insert",
            "column": ["id", "name", "qty", "price", "active"],
            "connection": {
              "table": ["e2e_src"],
              "jdbcUrl": "jdbc:duckdb:${e2e_out_dir}/e2e.duckdb"
            }
          }
        }
      }
    ]
  }
}
