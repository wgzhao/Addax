DBS="postgres"
SRC_DB=postgres
DST_DB=postgres

# The tz-aware case: identical to 140_postgresql_datetime except that the job runs
# with a JVM default timezone eight hours away from UTC. The golden is unchanged and
# is still rendered AT TIME ZONE 'UTC', so what this asserts is precisely the
# invariant that matters for tz-aware data -- the instant survives, while the wall
# clock the process happens to be in does not leak into the stored value.
#
# An implementation that treated a timestamp as a naive wall clock, or that applied
# the JVM zone when converting, would store these eight hours off and fail here while
# passing 140.
CASE_TZ="Asia/Shanghai"
