{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      },
      "errorLimit": {
        "record": 0
      }
    },
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "username": "${mysql_user}",
            "password": "${mysql_password}",
            "column": ["id", "name", "qty", "price", "active", "note"],
            "connection": {
              "table": ["e2e_src"],
              "jdbcUrl": ["${mysql_jdbc_url}"]
            }
          }
        },
        "writer": {
          "name": "mysqlwriter",
          "parameter": {
            "username": "${mysql_user}",
            "password": "${mysql_password}",
            "writeMode": "update(id)",
            "column": ["id", "name", "qty", "price", "active", "note"],
            "connection": {
              "table": ["e2e_upsert"],
              "jdbcUrl": "${mysql_jdbc_url}"
            }
          }
        }
      }
    ]
  }
}
