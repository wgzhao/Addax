# Defaults for the addax performance baseline.
#
# Source this file from run-baseline.sh. Every value can be overridden from the
# environment, and the runner's flags override the environment for one run.
#
# The defaults point at the maintainer's local test fixtures:
#   - MariaDB on wgzhao-pc (see the local-test-databases memory)
#   - the HA HDFS cluster described by /opt/app/addax/hdp-hdfs-site.xml
# They are intentionally not 127.0.0.1: the e2e suite owns the container ports,
# and a perf run must not silently pick up a different database.

PERF_RUNS="${PERF_RUNS:-3}"
PERF_WARMUP="${PERF_WARMUP:-1}"
PERF_PROFILE="${PERF_PROFILE:-1}"
PERF_CHANNEL="${PERF_CHANNEL:-4}"
PERF_ROWS="${PERF_ROWS:-2000000}"
PERF_HEAP="${PERF_HEAP:-4g}"
PERF_JFR_DELAY="${PERF_JFR_DELAY:-10s}"
PERF_OUT_ROOT="${PERF_OUT_ROOT:-${E2E_DIR:-.}/perf/results}"

MYSQL_HOST="${MYSQL_HOST:-wgzhao-pc}"
MYSQL_PORT="${MYSQL_PORT:-3306}"
MYSQL_USER="${MYSQL_USER:-wgzhao}"
# No default: set it in the environment (or a local, untracked file) so the
# benchmark does not commit a credential. The mysql_* cases fail fast without it.
MYSQL_PASSWORD="${MYSQL_PASSWORD:-}"
MYSQL_DB="${MYSQL_DB:-test}"
PERF_TABLE="${PERF_TABLE:-perf_source}"
PERF_SINK_TABLE="${PERF_SINK_TABLE:-perf_sink}"

HDFS_DEFAULT_FS="${HDFS_DEFAULT_FS:-hdfs://yytz}"
HDFS_SITE_PATH="${HDFS_SITE_PATH:-/opt/app/addax/hdp-hdfs-site.xml}"
HDFS_BASE="${HDFS_BASE:-/tmp/addax_perf}"
HADOOP_USER_NAME="${HADOOP_USER_NAME:-hive}"
